{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/connect.ts": {
      "maxDuration": 60
    },
    "api/oauth.ts": {
      "maxDuration": 60
    },
    "api/connection-media.ts": {
      "maxDuration": 300
    },
    "api/chat.ts": {
      "maxDuration": 300
    },
    "api/data.ts": {
      "maxDuration": 300
    },
    "api/doc.ts": {
      "maxDuration": 300
    },
    "api/sheet.ts": {
      "maxDuration": 300
    },
    "api/slides.ts": {
      "maxDuration": 300
    },
    "api/design.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "supportsCancellation": true,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/video.ts": {
      "maxDuration": 300
    },
    "api/browser.ts": {
      "maxDuration": 300
    },
    "api/cad.ts": {
      "maxDuration": 300
    },
    "api/web.ts": {
      "maxDuration": 300
    },
    "api/image.ts": {
      "maxDuration": 300
    },
    "api/studio-image.ts": {
      "maxDuration": 300
    },
    "api/cron.ts": {
      "maxDuration": 300
    },
    "api/phone.ts": {
      "maxDuration": 300
    },
    "api/call.ts": {
      "maxDuration": 30
    },
    "api/messages.ts": {
      "maxDuration": 300
    },
    "api/task-attachments.ts": {
      "maxDuration": 300
    },
    "api/email.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|openscad/|privacy|sms|download|install\\.sh|nalu\\.mjs).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/backgrounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "browsing-topics=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "installCommand": "npm ci"
}
