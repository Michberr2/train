# Nalu LTX-2.3 video server config. Copy to .env and edit, then `bash run.sh`.

# --- Auth (must match the value you set in n4lu's Vercel env: NALU_VIDEO_API_KEY) ---
# Generate one with:  openssl rand -hex 32
NALU_VIDEO_API_KEY=

# --- Public URL the browser uses to fetch finished clips ---
# With Cloudflare Tunnel (run.sh prints it), set this to that https URL.
# This is ALSO the value of NALU_VIDEO_BASE_URL in Vercel (the API posts to it).
PUBLIC_BASE_URL=

# --- Paths (defaults match setup.sh; usually leave as-is) ---
LTX_WEIGHTS_DIR=./weights
LTX_OUTPUT_DIR=./outputs
LTX_GEMMA_ROOT=./weights/gemma

# Override the auto-picked files only if you downloaded different variants:
# LTX_CHECKPOINT=./weights/ltx-2.3-22b-dev.safetensors
# LTX_DISTILLED_LORA=./weights/ltx-2.3-22b-distilled-lora-384-1.1.safetensors
# LTX_SPATIAL_UPSAMPLER=./weights/ltx-2.3-spatial-upscaler-x2-1.1.safetensors

# --- Quality / memory ---
# fp8-cast ≈ half the VRAM (fits ~48-80GB). Empty = full bf16 (needs 80GB+).
LTX_QUANTIZATION=fp8-cast
LTX_HEIGHT=704
LTX_WIDTH=1280
LTX_NUM_FRAMES=121      # 8k+1 only (97,105,113,121,…); 121 ≈ 5s @ 25fps
LTX_FRAME_RATE=25
# LTX_STEPS=0           # 0 = checkpoint default

# --- Custom LoRA you trained with ltx-trainer (optional) ---
# LTX_USER_LORA=/path/to/checkpoints/lora_weights_step_01000.safetensors:1.0

PORT=8000

# --- Cloudflare tunnel (run.sh) ---
# Leave blank for a quick throwaway URL, or set a named tunnel hostname.
TUNNEL_HOSTNAME=
